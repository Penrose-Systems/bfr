// A compute shader that reads one value through BFR's uniform buffer table
// (api/bfr.yaml, bfr_pipeline) and writes it through the storage buffer
// table. For the uniform table test; spirv.h holds it compiled, see
// compile.sh.
#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 1) in;

layout(set = 0, binding = 2) buffer Buffers {
    uint values[];
} buffers[];

layout(set = 0, binding = 6) uniform Uniforms {
    uint value;
} uniforms[];

layout(push_constant) uniform Push {
    uint target;
    uint source;
} push;

void main() {
    buffers[push.target].values[0] = uniforms[push.source].value;
}
