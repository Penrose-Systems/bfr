// A compute shader that traces rays as ray_query.comp does and writes the
// bits of the x of the first vertex, in object space, of the triangle each
// ray hits, or all ones for a miss or a box, from a structure built to allow
// data access. For the ray tracing tests; spirv.h holds it compiled, see
// compile.sh.
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_ray_tracing_position_fetch : require
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8) in;

layout(set = 0, binding = 2) buffer Buffers {
    uint values[];
} buffers[];

layout(set = 0, binding = 4) uniform accelerationStructureEXT structures[];

layout(push_constant) uniform Push {
    uint structure;
    uint results;
} push;

const uint kMiss = 0xFFFFFFFFu;
const float kSpacing = 5.0;
const float kDistance = 5.0;
const float kFar = 100.0;

void main() {
    const uint ray = gl_LocalInvocationIndex;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, structures[push.structure], gl_RayFlagsNoneEXT, 0xFF,
                          vec3(float(ray) * kSpacing, 0.0, -kDistance), 0.0, vec3(0.0, 0.0, 1.0), kFar);
    while (rayQueryProceedEXT(query)) {
    }
    uint hit = kMiss;
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        vec3 positions[3];
        rayQueryGetIntersectionTriangleVertexPositionsEXT(query, true, positions);
        hit = floatBitsToUint(positions[0].x);
    }
    buffers[push.results].values[ray] = hit;
}
