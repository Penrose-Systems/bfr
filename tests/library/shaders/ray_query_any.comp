// ray_query.comp, but taking every triangle it meets as hit, opaque or not,
// so a triangle is missed only where an opacity micromap makes it so. A compute
// shader that traces rays inline against a top acceleration
// structure from BFR's table (api/bfr.yaml, bfr_pipeline): ray i starts at
// x = 5i, five units in front of z = 0, and goes along +z. It writes the
// custom index of the instance it hits, or all ones for a miss, and takes a
// box it meets as hit where it is. For the ray tracing tests; spirv.h holds
// it compiled, see compile.sh.
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8) in;

layout(set = 0, binding = 2) buffer Buffers {
    uint values[];
} buffers[];

layout(set = 0, binding = 4) uniform accelerationStructureEXT structures[];

layout(push_constant) uniform Push {
    uint structure;
    uint results;
} push;

const uint kMiss = 0xFFFFFFFFu;
const float kSpacing = 5.0;
const float kDistance = 5.0;
const float kFar = 100.0;

void main() {
    const uint ray = gl_LocalInvocationIndex;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, structures[push.structure], gl_RayFlagsNoneEXT, 0xFF,
                          vec3(float(ray) * kSpacing, 0.0, -kDistance), 0.0, vec3(0.0, 0.0, 1.0), kFar);
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            rayQueryGenerateIntersectionEXT(query, kDistance);
        }
        else {
            rayQueryConfirmIntersectionEXT(query);
        }
    }
    uint hit = kMiss;
    if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        hit = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
    }
    buffers[push.results].values[ray] = hit;
}
