// A ray generation shader that traces ray i from x = 5i, five units in front
// of z = 0, along +z, against a top acceleration structure from BFR's table
// (api/bfr.yaml, bfr_pipeline), and writes what the hit or miss shader left in
// its payload. For the ray tracing tests; spirv.h holds it compiled, see
// compile.sh.
#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require

layout(set = 0, binding = 2) buffer Buffers {
    uint values[];
} buffers[];

layout(set = 0, binding = 4) uniform accelerationStructureEXT structures[];

layout(push_constant) uniform Push {
    uint structure;
    uint results;
} push;

layout(location = 0) rayPayloadEXT uint hit;

const float kSpacing = 5.0;
const float kDistance = 5.0;
const float kFar = 100.0;

void main() {
    const uint ray = gl_LaunchIDEXT.x;
    // Hit groups by instance offset, one record per geometry; miss record 0.
    traceRayEXT(structures[push.structure], gl_RayFlagsNoneEXT, 0xFF, 0, 1, 0,
                vec3(float(ray) * kSpacing, 0.0, -kDistance), 0.0, vec3(0.0, 0.0, 1.0), kFar, 0);
    buffers[push.results].values[ray] = hit;
}
