# Fails unless LIBRARY's dynamic symbol table defines only bfr_* symbols.
execute_process(COMMAND ${NM} -D --defined-only ${LIBRARY}
    RESULT_VARIABLE result OUTPUT_VARIABLE symbols ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "${NM} failed:\n${error}")
endif()
string(REGEX MATCHALL "[^\n]+" lines "${symbols}")
set(exported "")
foreach(line ${lines})
    string(REGEX REPLACE "^.* " "" name "${line}")
    if(NOT name MATCHES "^bfr_")
        message(FATAL_ERROR "exports ${name}")
    endif()
    list(APPEND exported ${name})
endforeach()
list(FIND exported bfr_create_instance found)
if(found EQUAL -1)
    message(FATAL_ERROR "does not export bfr_create_instance")
endif()
