# Fails unless LIBRARY's dynamic symbol table defines exactly the C functions
# api/bfr.yaml declares: none missing, nothing else.
execute_process(COMMAND ${PYTHON} ${GENERATOR} --functions
    RESULT_VARIABLE result OUTPUT_VARIABLE declared ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "${GENERATOR} --functions failed:\n${error}")
endif()
string(REGEX MATCHALL "[^\n]+" declared "${declared}")
execute_process(COMMAND ${NM} -D --defined-only ${LIBRARY}
    RESULT_VARIABLE result OUTPUT_VARIABLE symbols ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "${NM} failed:\n${error}")
endif()
string(REGEX MATCHALL "[^\n]+" lines "${symbols}")
set(exported "")
foreach(line ${lines})
    string(REGEX REPLACE "^.* " "" name "${line}")
    list(FIND declared ${name} found)
    if(found EQUAL -1)
        message(FATAL_ERROR "exports ${name}, which api/bfr.yaml does not declare")
    endif()
    list(APPEND exported ${name})
endforeach()
foreach(name ${declared})
    list(FIND exported ${name} found)
    if(found EQUAL -1)
        message(FATAL_ERROR "does not export ${name}")
    endif()
endforeach()
