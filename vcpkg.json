{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "bfr",
  "version": "0.1.0",
  "dependencies": [
    "catch2",
    {
      "name": "glfw3",
      "features": [
        { "name": "wayland", "platform": "linux" }
      ]
    },
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        { "name": "x11", "platform": "linux" },
        { "name": "wayland", "platform": "linux" }
      ]
    },
    {
      "name": "d3d12-memory-allocator",
      "platform": "windows"
    },
    "volk",
    "vulkan-memory-allocator",
    "vulkan-utility-libraries",
    "vulkan-validationlayers"
  ],
  "overrides": [
    {
      "$comment": "3.16.1's catch_discover_tests passes EXTRA_ARGS as one argument (CatchAddTests.cmake prepare_command_fragment quotes the list)",
      "name": "catch2",
      "version": "3.15.3"
    }
  ]
}
